{
  "index": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "refresh_interval": "5s",
    "lifecycle": {
      "name": "search_logs_policy",
      "rollover_alias": "search_logs"
    }
  },
  "analysis": {
    "analyzer": {
      "keyword_analyzer": {
        "type": "custom",
        "tokenizer": "keyword",
        "filter": ["lowercase", "trim"]
      }
    }
  }
}